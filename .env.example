# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database (optional, PostgreSQL uchun)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=tort_markazi
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_PORT=5432

# Telegram bot (orders/services.py)
# Token @BotFather dan olinadi. Chat ID bir nechta bo'lishi mumkin: "123,456"
# Guruh uchun ID manfiy bo'ladi: "-1001234567890"
TELEGRAM_BOT_TOKEN=8726232314:AAHuGJebCpFjqoDvJrHA7CaP7FzCE5ZXGXI
TELEGRAM_CHAT_ID=8433184363
TELEGRAM_TIMEOUT=8

# Saytning ochiq manzili — Telegram xabarlaridagi havolalar uchun.
# Localhost bo'lsa, xabarlarga "Buyurtmani ochish" tugmasi qo'shilmaydi.
SITE_URL=http://127.0.0.1:8001

# Frontend origin (CORS)
DJANGO_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Saytni faqat ro'yxatdan o'tgan (kiringan) foydalanuvchilar ko'radi.
# False — saytni hamma uchun ochiq qiladi (sinov uchun).
SITE_REQUIRE_LOGIN=True

# Administrator akkaunti — `python manage.py create_admin` shu yerdan o'qib
# yaratadi/yangilaydi. Parol kod ichida saqlanmaydi, faqat shu faylda.
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me-to-a-strong-password
