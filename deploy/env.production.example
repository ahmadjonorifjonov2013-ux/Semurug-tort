# Production ( hosting ) sozlamalari — shablon.
#   cp deploy/env.production.example .env.production
#   keyin har bir qiymatni to'ldiring (maxfiy kalitni quyidagi buyruq beradi):
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
#
# Ishga tushirish:
#   DJANGO_ENV_FILE=.env.production ./deploy/tunnel.sh

DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_DEBUG=False

# Tunnel manzili trycloudflare.com bo'lsa quyidagicha qoldiring.
# DIQQAT: Django "*.domain" ni emas, ".domain" ni tushunadi (nuqta bilan).
# Doimiy domen bo'lsa, o'sha domenni ham qo'shing.
DJANGO_ALLOWED_HOSTS=.trycloudflare.com,127.0.0.1,localhost

# --- Render.com uchun ---
# Hosting PostgreSQL manzili. Bo'sh qoldirilsa lokal SQLite ishlatiladi.
# Render'da bu qiymatni o'zi qo'yadi (Environment da ko'rinadi) —
# faqat lokal sinab ko'rish uchun kerak bo'lsa to'ldiring.
# DATABASE_URL=postgresql://user:parol@host:5432/bazanomi
# SSLMODE=require

# Rasmlar va boshqa media fayllarini Django beradi (nginx yo'q).
MEDIA_VIA_DJANGO=True

# Saytning ochiq manzili — Telegram xabarlaridagi havolalar uchun.
# Tunnel ishga tushgandan keyin cloudflared chiqargan manzilni yozing.
SITE_URL=https://example.trycloudflare.com

# Frontend origin (CORS) — sayt bir xil domenda bo'lsa bo'sh qoldiring.
DJANGO_CORS_ORIGINS=

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT=8

DJANGO_LOG_LEVEL=INFO
