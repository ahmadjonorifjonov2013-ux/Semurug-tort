# Vercel muhit o'zgaruvchilari — shablon (maxfiy kalitlar YO'Q).
#
# Vercel'da to'ldirish:
#   npx vercel env add <NAME> production        (bo'sh qiymat so'raydi, kiriting)
#   yoki Dashboard -> Settings -> Environment Variables
#
# DATABASE_URL ni Neon'dan oladi:
#   https://console.neon.tech  ->  yangi loyiha (bepul)  ->  Connection string
#   Uni Vercel'ga o'zgartirish shart emas — shu holatda DATABASE_URL
#   sifatida shu yerga yoziladi. SSLMODE=require Neon uchun to'g'ri.

# --- Django ---
DJANGO_SECRET_KEY=<python -c "import secrets; print(secrets.token_urlsafe(50))">
DJANGO_DEBUG=False

# Vercel'da domen nomi avtomatik. Preview ( Deployments ) manzillari uchun
# ".vercel.app" qo'shiladi.
DJANGO_ALLOWED_HOSTS=khabibullayev-os.vercel.app,.vercel.app

# Rasmlar va media fayllarini Django beradi (Vercel CDN faqat static beradi).
MEDIA_VIA_DJANGO=True

# Telegram xabarlaridagi havolalar uchun.
SITE_URL=https://khabibullayev-os.vercel.app

# Sayt bitta domenda — frontend origin ham shu, CORS kerak emas.
DJANGO_CORS_ORIGINS=

# --- Database (Neon / Vercel Postgres) ---
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
SSLMODE=require

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=<872623...>
TELEGRAM_CHAT_ID=<843318...>
TELEGRAM_TIMEOUT=8

DJANGO_LOG_LEVEL=INFO